# Copy to .env and fill in. NEVER commit real values.
# See README.md for how to obtain each value.

# Postgres connection string. Local dev via docker-compose:
#   postgres://postgres:postgres@localhost:5432/strcleaning
DATABASE_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Calendar scope is requested at sign-in so the dispatcher "connects Gmail"
# in the same consent screen. See ARCHITECTURE.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
AUTH_SECRET=
# Any random 32+ byte string. Generate: openssl rand -base64 32
AUTH_URL=http://localhost:3000

# 32-byte hex key for field-level encryption of access instructions
# and stored OAuth refresh tokens. Generate: openssl rand -hex 32
# NEVER commit the real key. NEVER log decrypted values.
ACCESS_INSTRUCTIONS_KEY=

# Local dev only: password for the least-privilege `app` Postgres role
# (used by docker-compose init script). Production sets its own.
APP_DB_PASSWORD=app

# Bootstrap: email allowed to sign in as owner when the users table is empty.
# Used once to create the first owner account, then leave unset.
BOOTSTRAP_OWNER_EMAIL=

# Seed script demo values (obviously fake — never real names/numbers)
SEED_OWNER_EMAIL=owner@example.com
SEED_DISPATCHER_EMAIL=dispatcher@example.com
SEED_AGENCY_NAME="Demo Cleaning Agency"
SEED_DISPATCHER_PHONE=+15550001111

# --- Workstream E: notifications ---
# Resend (https://resend.com) — all outbound email: reminders, Saturday
# recap, daily digest, message-fallback notifications.
RESEND_API_KEY=
RESEND_FROM=

# SMS transport: device_bridge (default — SMS queued for the owner's
# paired phone; see docs/sms-device-bridge.md) or twilio (documented
# fallback only).
SMS_PROVIDER=device_bridge
# Only needed when SMS_PROVIDER=twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
